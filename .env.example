# The Latest Cyber Crime News job needs NO secrets: it only reads public RSS feeds.
# Nothing here is required. Real keys must never be committed or put in browser code.
# If you later add optional AI/Hindi summaries, put the key here (server side only), e.g.:
# NEWS_SUMMARY_API_KEY=

# Needed to download the participants list: open http://localhost:8080/api/admin/export.csv?token=YOUR_TOKEN
# Use a long random value (at least 12 characters). Never share it or commit the real .env file.
ADMIN_TOKEN=

# --- Server settings (all optional) ---
PORT=8080
# 127.0.0.1 = only this computer. Use 0.0.0.0 on a real server so visitors can reach it.
HOST=127.0.0.1
# How often the server fetches fresh news (minutes, minimum 5).
NEWS_INTERVAL_MIN=15
